<% layout("layout/boilerplate") %><!--Here there is no need to specify location <'% layout("../layout/boilerplate") %>-->
   <!--Inserting the cluster map-->
   <div id="cluster-map"></div>
  <h1>All Campgrounds</h1>
     <!-- <ul>--> 
   <% for(let camp of campgrounds){ %>
    <!--<li> <a href="/campgrounds/<%#=camp.id%>"><%#=camp.title %></a></li> -->
     <div class="card mb-3">
      <div class="row">
        <div class="col-md-4">
          <!--adding a basic default sourc in case the campground has no images to prevent undefined url error-->
          <%if(camp.images.length) {%>
            <!--Here if there is any image display that and otherwise is the else statement-->
          <img class="img-fluid" alt="" src="<%=camp.images[0].url%>">
          <% }else {%>
            <!--Here I'm giving the default camp to be displayed in src="" (I can also give src="" as empty )-->
          <img class="img-fluid" alt="" src="https://res.cloudinary.com/syicct8d/image/upload/v1793430351/YelpCamp2/dr6bhpxtf7bmxwbojpy8.jpg">
          <%}%>
        </div>
        <div class="col-md-8">
          <div class="card-body">
            <h5 class="card-title"><%=camp.title%></h5>
             <p class="card-text"><%=camp.description%></p>
              <p class="card-text">
                <small class="text-muted"><%=camp.location%></small>
              </p>
              <a class="btn btn-primary" href="/campgrounds/<%=camp.id%>">View</a>
          </div>
        </div>
      </div>
     </div>
    <% } %>
   <!-- </ul>--> 

<!--Mapbox token that is passed into the below js file-->
<script>
  const mapToken = '<%=process.env.MAPBOX_TOKEN%>'
  //to pass in our campgrounds data to clusteMap.js
  const campgrounds = {features: <%-JSON.stringify(campgrounds)%>}
</script>

<!--Cluster map script link-->
<script src="/javascripts/clusterMap.js"></script>