<% layout("layout/boilerplate") %>

<div class="row">
  <h1 class="text-center">Edit Campground</h1>
  <div class="col-md-6 offset-md-3">
    <form
      action="/campgrounds/<%=campground.id%>?_method=PUT"
      method="post"
      novalidate
      class="validated-form"
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <label class="from-label" for="title">title:</label>
        <input
          class="form-control"
          type="text"
          id="title"
          name="campground[title]"
          value="<%=campground.title%>"
          required
        />
      </div>
      <div class="mb-3">
        <label class="from-label" for="location">location:</label>
        <input
          class="form-control"
          type="text"
          id="location"
          name="campground[location]"
          value="<%=campground.location%>"
          required
        />
      </div>

      <div class="mb-3">
        <label class="from-label" for="price">price:</label>
        <!--I put label outside input group-->
        <div class="input-group">
          <!-- <label> here is❌ Cannot put label inside input group-->
          <span class="input-group-text" id="price-label">$</span>
          <input
            type="text"
            id="price"
            class="form-control"
            placeholder="0.00"
            aria-label="price"
            aria-describedby="price-label"
            name="campground[price]"
            value="<%=campground.price%>"
            required
          />
        </div>
      </div>

      <div class="mb-3">
        <label class="from-label" for="description">Description:</label>
        <textarea
          class="form-control"
          type="text"
          id="description"
          name="campground[description]"
          rows="3"
          required
        >
<%=campground.description%>
        </textarea>
      </div>

      <!--Image File input button-->
      <div class="mb-3">
        <label for="inputGroupFile02" class="form-label">
          Add more images:
        </label>

        <input
          type="file"
          class="form-control"
          id="inputGroupFile02"
          name="image"
          multiple
        />
      </div>

      <!--Checkbox with image-->
      <div class="mb-3"><% campground.images.forEach(function(img, i){ %>
      <!-- <img src="<%#=img.url %>" class="img-thumbnail" alt=""> I replaced this for thumbnail-->
        <img src="<%=img.thumbnail %>" class="img-thumbnail" alt="">
       <div class="form-check-inline">
        <input type="checkbox" id="image-<%=i %>" name="deleteImages[]" value="<%= img.filename %>"> <!--We need unique id for each image so we will use the id-->
       </div>
       <label for="image-<%=i %>">Delete</label>
        <% }) %>
      </div>
      
      <div class="mb-3">
        <button class="btn btn-primary" type="submit">Update Campground</button>
      </div>
    </form>
   <div class="d-flex justify-content-end mb-3">
    <a class="btn btn-secondary"  href="/campgrounds/<%=campground.id%>">Cancel</a>
   </div>
  </div>
</div>

