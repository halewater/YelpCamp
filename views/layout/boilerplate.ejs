      integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC"
      crossorigin="anonymous"
    />
    <!--Mapbox GL JS-->

    <!-- Includes the Mapbox GL JS CSS stylesheet -->
    <link
      href="https://api.mapbox.com/mapbox-gl-js/v3.33.0/mapbox-gl.css"
      rel="stylesheet"
    />
    <!-- Imports the Mapbox GL JS bundle -->
    <script src="https://api.mapbox.com/mapbox-gl-js/v3.33.0/mapbox-gl.js"></script>

    <!--link for the map style sheet-->
    <link rel="stylesheet" href="/stylesheets/app.css" />
